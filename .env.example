# Supabase (server-side only; never expose the service role key to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (free). Model id is read from env - confirm the current Flash id in AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Protects /api/cron/weekly-digest. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Resend (free tier). Without a verified domain, Resend only delivers to your own account email.
RESEND_API_KEY=
DIGEST_TO_EMAIL=

# Optional: free Stack Exchange app key to raise the daily quota
STACKEXCHANGE_KEY=
