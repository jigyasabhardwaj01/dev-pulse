# Supabase (server-side only; never expose the service role key to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (free). Model id is read from env - confirm the current Flash id in AI Studio.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Protects /api/cron/weekly-digest. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Resend (free tier). Without a verified domain, Resend only delivers to your own account email.
RESEND_API_KEY=
DIGEST_TO_EMAIL=

# Optional: free Stack Exchange app key to raise the daily quota
STACKEXCHANGE_KEY=

# Optional: Reddit app-only OAuth (a "script" or "web" app at reddit.com/prefs/apps). Without both, the public feed is used,
# which Reddit limits to roughly one request per minute.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Optional: a descriptive User-Agent for Reddit ("appname/1.0 (by /u/yourusername)")
REDDIT_USER_AGENT=
# Optional: raises GitHub's search rate limit
GITHUB_TOKEN=
# Dashboard URL used for the link inside the email
APP_URL=

