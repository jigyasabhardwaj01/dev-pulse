# Supabase (server-side only; never expose the service role key to the browser)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Google AI Studio (free). Model id is read from env - confirm the current Flash id in AI Studio.
OPENROUTER_API_KEY=
# Must be a google/ model id from https://openrouter.ai/api/v1/models. Defaults to google/gemini-3.7-flash (verified 2026-10-12).
OPENROUTER_MODEL=google/gemini-3.7-flash

# Protects /api/cron/weekly-digest. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Resend (free tier). Without a verified domain, Resend only delivers to your own account email.
RESEND_API_KEY=
DIGEST_TO_EMAIL=

# Optional: free Stack Exchange app key to raise the daily quota
STACKEXCHANGE_KEY=

# Optional: Reddit app-only OAuth (a "script" or "web" app at reddit.com/prefs/apps). Without both, the public feed is used,
# which Reddit limits to roughly one request per minute.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Reddit is OFF unless the two credentials above are set, or this is 1 (public feed; it was rate limited from Vercel).
REDDIT_PUBLIC_ENABLED=
# Optional: a descriptive User-Agent for Reddit ("appname/1.0 (by /u/yourusername)")
REDDIT_USER_AGENT=
# Optional: raises GitHub's search rate limit
GITHUB_TOKEN=
# Dashboard URL used for the link inside the email
APP_URL=


# Team sign-in (JARVIS 2.0). SESSION_SECRET: 16+ random characters (e.g. `openssl rand -hex 24`). Without it, sign-in is disabled.
SESSION_SECRET=
# Owner defaults to DIGEST_TO_EMAIL. Team members: comma-separated emails allowed to shortlist and vote.
JARVIS_OWNER_EMAIL=
JARVIS_TEAM_EMAILS=
